# Copy to .env (local) or set in Vercel -> Project -> Settings -> Environment Variables.
# NEVER commit real values.

# --- Required ---------------------------------------------------------
# Web database (MariaDB/MySQL). Tables are created by `npm run migrate`.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/ninjamelon_web
# >= 32 random characters (openssl rand -hex 32). Signs CAPTCHA/answers.
APP_SECRET=
# Public URL of the site (used in e-mail links and Origin checks).
SITE_URL=https://ninjamelon.cz
# Stable Minecraft UUID of the owner (X4yl0n). Owner role is granted only when
# an account linked via the in-game code has exactly this UUID.
OWNER_MINECRAFT_UUID=

# --- Minecraft login (AuthMe) — choose ONE mode -------------------------
# A) direct, read-only DB user (host must be reachable from Vercel)
AUTHME_DATABASE_URL=
AUTHME_TABLE=authme
# B) bridge service next to the MC server (see docs/DEPLOY.md)
AUTHME_BRIDGE_URL=
AUTHME_BRIDGE_SECRET=

# --- Optional features ----------------------------------------------------
# E-mail (verification, password reset). Without it e-mail features are off.
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
MAIL_FROM="NinjaMelon <no-reply@ninjamelon.cz>"
# Shared secret for the Minecraft plugin (/web link, votes). >= 32 chars.
PLUGIN_API_SECRET=
# Ticket notifications to Discord (ID + category only, never content).
DISCORD_WEBHOOK_URL=
# Reserved for a future payment integration. Checkout stays disabled without it.
PAYMENT_PROVIDER=

# --- Local development only ----------------------------------------------
API_PORT=3001
